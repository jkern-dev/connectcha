# Copied to supabase/functions/.env by `make up`. Values below are the fixed
# local Supabase Storage S3 credentials printed by `supabase status`.
# Production: point S3_ENDPOINT at the R2 account endpoint, S3_BUCKET at the
# private bucket, S3_REGION=auto, and use the R2 API token's keys.
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_INTERNAL_ENDPOINT=http://kong:8000/storage/v1/s3
S3_BUCKET=media
S3_REGION=local
S3_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_SECRET_ACCESS_KEY=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# Shared secret between the push_outbox database webhook and send-push.
PUSH_WEBHOOK_SECRET=local-dev-push-secret

# APNs: "stub" records deliveries for the simulator bridge; "apns" sends for real.
# Production or sandbox is chosen per token (D-33), so there is no environment
# setting here. APNS_PRIVATE_KEY is the .p8 file's contents with newlines as \n.
APNS_MODE=stub
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.connectcha.app
APNS_PRIVATE_KEY=
