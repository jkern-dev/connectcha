# Copy to supabase/.hosted.env (gitignored). Read by scripts/hosted-setup.sh.
# Never paste these values into chat or commit them.

# Supabase: Project Settings → General (reference), → Database (password you set
# when creating the project; "Connect" dialog for the session-pooler URL).
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Session pooler URL from the "Connect" dialog (works over IPv4), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Cloudflare R2: Overview page (account id), the bucket, and an API token with
# Object Read & Write on that bucket (Manage R2 API Tokens).
R2_ACCOUNT_ID=
R2_BUCKET=connectcha-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Shared secret between the database webhook and the send-push / cleanup-orphans
# functions. Any long random string: `openssl rand -hex 32`.
PUSH_WEBHOOK_SECRET=

# APNs (after the Apple Developer account exists). Leave APNS_MODE=stub until the
# .p8 key is in hand; "apns" sends for real. APNS_PRIVATE_KEY is the whole .p8
# file with its line breaks written as \n.
APNS_MODE=stub
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.connectcha.app
APNS_PRIVATE_KEY=
